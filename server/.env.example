# ── Sweet Eye Coffee API ────────────────────────────────────────────────
PORT=4000
APP_NAME="Sweet Eye Coffee Roasters"

# On the VPS: NODE_ENV=production and PUBLIC_URL=https://yourdomain.com
# (locks CORS / Stripe returns / photo links to your domain, turns on HSTS and strict rate limits).
NODE_ENV=development
PUBLIC_URL=

# Same MySQL/MariaDB database the website used (XAMPP / phpMyAdmin)
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=sweet_eye_coffee
DB_USERNAME=root
DB_PASSWORD=
# Database on another server (e.g. Hostinger Remote MySQL): encrypt the connection.
DB_SSL=false

# Signs app login tokens. Keep it secret; changing it signs everyone out.
JWT_SECRET=

# live = real payments (Square cards + Stripe wallets). test = orders are saved without charging anything.
PAYMENTS_MODE=test

# Square: card payments; every app order also appears in Square POS
SQUARE_ACCESS_TOKEN=
SQUARE_APPLICATION_ID=
SQUARE_LOCATION_ID=
SQUARE_ENVIRONMENT=production

# Stripe: Apple Pay, Google Pay, Cash App Pay and cards on Stripe's secure page
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# UPS: live rates for faster coffee-bean shipping (quotes only)
UPS_CLIENT_ID=
UPS_CLIENT_SECRET=
UPS_ACCOUNT_NUMBER=
UPS_ENVIRONMENT=production

# Email (receipts, password-reset codes, contact form). false = print them in the API console instead.
MAIL_ENABLED=false
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME="support@sweeteyecoffee.com"
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="support@sweeteyecoffee.com"
MAIL_FROM_NAME="Sweet Eye Coffee"
